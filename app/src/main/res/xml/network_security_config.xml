<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS verifies certificate chains and hostnames using the device's
         system CAs and explicitly installed user CAs. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
